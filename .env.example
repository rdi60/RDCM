# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=rdcm
POSTGRES_USER=rdcm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional: shown as a nav link if set (Phase 0 HRMS integration = link only)
HRMS_URL=

# HIPAA technical safeguards (see SECURITY.md)
# Required — field-level encryption at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit this value or change it without a planned re-encryption migration.
FIELD_ENCRYPTION_KEY=

