# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=rdcm
POSTGRES_USER=rdcm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Production only (config/settings/prod.py). Required once you're serving
# over HTTPS behind the bundled Nginx — without CSRF_TRUSTED_ORIGINS, login
# and every other POST will fail with a 403 once DEBUG=False. Include the
# scheme, no trailing slash, every hostname you use.
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Set to False only temporarily, if you're bringing the app up before TLS is
# ready — keep it True for any real deployment (HIPAA requires encryption
# in transit).
DJANGO_SECURE_SSL_REDIRECT=True

# Optional: shown as a nav link if set (Phase 0 HRMS integration = link only)
HRMS_URL=

# HIPAA technical safeguards (see SECURITY.md)
# Required — field-level encryption at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit this value or change it without a planned re-encryption migration.
FIELD_ENCRYPTION_KEY=

# Optional tuning (sane defaults if left unset):
# SESSION_IDLE_TIMEOUT_SECONDS=900
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_HOURS=1
# WHATSAPP_INCLUDE_CLINICAL_DETAILS=False

# Set to False only for a throwaway test environment with no real patient
# data in it, to skip the mandatory TOTP enrollment while testing. Turn
# this back on (or just remove the line — True is the default) before any
# real use.
# REQUIRE_MFA=True
